{
  "config": {
    "data": {
      "raw_data_path": "data/raw",
      "processed_data_path": "data/processed",
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "test_ratio": 0.15,
      "random_seed": 42,
      "normal_samples": 5000,
      "malicious_samples": 5000,
      "max_input_length": 2048,
      "min_input_length": 10
    },
    "features": {
      "use_statistical_features": true,
      "use_semantic_features": true,
      "use_pattern_features": true,
      "statistical": [
        "input_length",
        "input_entropy",
        "unique_token_ratio",
        "special_char_ratio",
        "avg_word_length"
      ],
      "pattern": [
        "repetition_ratio",
        "unusual_token_ratio",
        "punctuation_density",
        "unmatched_bracket_ratio"
      ],
      "semantic": [
        "sentence_embedding",
        "semantic_diversity",
        "coherence_score"
      ]
    },
    "model": {
      "detector_type": "ensemble",
      "random_forest": {
        "n_estimators": 100,
        "max_depth": 10,
        "min_samples_split": 5,
        "n_jobs": -1
      },
      "svm": {
        "kernel": "rbf",
        "C": 1.0,
        "gamma": "scale"
      },
      "ensemble": {
        "models": [
          "random_forest",
          "gradient_boosting",
          "svm"
        ],
        "voting": "soft"
      },
      "test_size": 0.2,
      "random_state": 42
    },
    "training": {
      "batch_size": 32,
      "num_epochs": 50,
      "learning_rate": 0.001,
      "validation_split": 0.2,
      "early_stopping_patience": 10,
      "model_save_path": "models/detector_model.pkl"
    },
    "evaluation": {
      "metrics": [
        "accuracy",
        "precision",
        "recall",
        "f1_score",
        "roc_auc"
      ],
      "detection_threshold": 0.5,
      "high_confidence_threshold": 0.8
    },
    "logging": {
      "level": "INFO",
      "log_file": "logs/training.log"
    },
    "service": {
      "max_latency_ms": 100,
      "enable_cache": true,
      "cache_size": 10000,
      "enable_batch_processing": false,
      "batch_timeout_ms": 500
    }
  },
  "test_metrics": {
    "accuracy": 1.0,
    "precision": 1.0,
    "recall": 1.0,
    "f1_score": 1.0,
    "roc_auc": 1.0,
    "pr_auc": 1.0,
    "true_negative_rate": 1.0,
    "false_positive_rate": 0.0,
    "false_negative_rate": 0.0
  },
  "model_type": "ensemble"
}